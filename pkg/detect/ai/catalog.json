{
  "providers": [
    {
      "name": "anthropic",
      "hostnames": ["api.anthropic.com", "*.api.anthropic.com"],
      "pathPrefixes": ["/v1/messages", "/v1/complete"],
      "headerNames": ["anthropic-version", "anthropic-beta", "anthropic-dangerous-direct-browser-access"]
    },
    {
      "name": "openai",
      "hostnames": ["api.openai.com", "*.api.openai.com"],
      "headerNames": ["openai-organization", "openai-project", "openai-beta"]
    },
    {
      "name": "azure-openai",
      "hostnames": ["*.openai.azure.com", "*.cognitiveservices.azure.com", "*.services.ai.azure.com", "*.inference.ai.azure.com"],
      "pathPrefixes": ["/openai/deployments/", "/openai/responses"]
    },
    {
      "name": "google",
      "hostnames": ["generativelanguage.googleapis.com", "aiplatform.googleapis.com", "*-aiplatform.googleapis.com"],
      "pathPrefixes": ["/v1beta/models/", "/v1/projects/"],
      "headerNames": ["x-goog-api-key"]
    },
    {
      "name": "bedrock",
      "hostnames": ["bedrock-runtime.*.amazonaws.com", "bedrock.*.amazonaws.com", "bedrock-agent-runtime.*.amazonaws.com", "bedrock-runtime-fips.*.amazonaws.com"],
      "pathPrefixes": ["/model/"],
      "headerNames": ["x-amzn-bedrock-accept", "x-amzn-bedrock-trace", "x-amzn-bedrock-guardrailidentifier"]
    },
    {
      "name": "mistral",
      "hostnames": ["api.mistral.ai", "codestral.mistral.ai"]
    },
    {
      "name": "cohere",
      "hostnames": ["api.cohere.com", "api.cohere.ai"]
    },
    {
      "name": "openrouter",
      "hostnames": ["openrouter.ai", "*.openrouter.ai"]
    },
    {
      "name": "groq",
      "hostnames": ["api.groq.com"]
    },
    {
      "name": "fireworks",
      "hostnames": ["api.fireworks.ai", "*.fireworks.ai"]
    },
    {
      "name": "together",
      "hostnames": ["api.together.xyz", "api.together.ai"]
    },
    {
      "name": "xai",
      "hostnames": ["api.x.ai"]
    },
    {
      "name": "deepseek",
      "hostnames": ["api.deepseek.com"]
    },
    {
      "name": "perplexity",
      "hostnames": ["api.perplexity.ai"]
    },
    {
      "name": "huggingface",
      "hostnames": ["api-inference.huggingface.co", "router.huggingface.co", "*.endpoints.huggingface.cloud"]
    },
    {
      "name": "ollama",
      "hostnames": ["ollama", "ollama.*", "*.ollama.*"],
      "pathPrefixes": ["/api/generate", "/api/chat"],
      "ports": [11434],
      "selfHosted": true
    },
    {
      "name": "vllm",
      "hostnames": ["vllm", "vllm.*", "*.vllm.*"],
      "ports": [8000],
      "selfHosted": true
    },
    {
      "name": "lmstudio",
      "hostnames": ["lmstudio", "lmstudio.*"],
      "ports": [1234],
      "selfHosted": true
    }
  ],
  "llmEndpoints": [
    {"pattern": "/v1/messages", "kind": "messages"},
    {"pattern": "/v1/messages/count_tokens", "kind": "messages.count_tokens"},
    {"pattern": "/v1/messages/batches", "kind": "messages.batches"},
    {"pattern": "/v1/complete", "kind": "complete"},
    {"pattern": "/v1/chat/completions", "kind": "chat.completions"},
    {"pattern": "/v1/completions", "kind": "completions"},
    {"pattern": "/v1/responses", "kind": "responses"},
    {"pattern": "/v1/embeddings", "kind": "embeddings"},
    {"pattern": "/v1/rerank", "kind": "rerank"},
    {"pattern": "/openai/v1/chat/completions", "kind": "chat.completions"},
    {"pattern": "/openai/v1/completions", "kind": "completions"},
    {"pattern": "/openai/v1/embeddings", "kind": "embeddings"},
    {"pattern": "/openai/responses", "kind": "responses"},
    {"pattern": "/openai/deployments/*/chat/completions", "kind": "chat.completions"},
    {"pattern": "/openai/deployments/*/completions", "kind": "completions"},
    {"pattern": "/openai/deployments/*/embeddings", "kind": "embeddings"},
    {"pattern": "/v1beta/models/*:generateContent", "kind": "generateContent"},
    {"pattern": "/v1beta/models/*:streamGenerateContent", "kind": "streamGenerateContent"},
    {"pattern": "/v1beta/models/*:countTokens", "kind": "countTokens"},
    {"pattern": "/v1beta/models/*:embedContent", "kind": "embedContent"},
    {"pattern": "/v1/models/*:generateContent", "kind": "generateContent"},
    {"pattern": "/v1/models/*:streamGenerateContent", "kind": "streamGenerateContent"},
    {"pattern": "/v1/projects/*/locations/*/publishers/*/models/*:generateContent", "kind": "generateContent"},
    {"pattern": "/v1/projects/*/locations/*/publishers/*/models/*:streamGenerateContent", "kind": "streamGenerateContent"},
    {"pattern": "/v1/projects/*/locations/*/publishers/*/models/*:predict", "kind": "predict"},
    {"pattern": "/v1/projects/*/locations/*/publishers/*/models/*:rawPredict", "kind": "rawPredict"},
    {"pattern": "/v1/projects/*/locations/*/endpoints/*:predict", "kind": "predict"},
    {"pattern": "/model/*/invoke", "kind": "bedrock.invoke"},
    {"pattern": "/model/*/invoke-with-response-stream", "kind": "bedrock.invoke-stream"},
    {"pattern": "/model/*/converse", "kind": "bedrock.converse"},
    {"pattern": "/model/*/converse-stream", "kind": "bedrock.converse-stream"},
    {"pattern": "/api/generate", "kind": "ollama.generate"},
    {"pattern": "/api/chat", "kind": "ollama.chat"},
    {"pattern": "/api/embed", "kind": "ollama.embed"},
    {"pattern": "/api/embeddings", "kind": "ollama.embeddings"},
    {"pattern": "/v2/chat", "kind": "cohere.chat"},
    {"pattern": "/v1/chat", "kind": "cohere.chat"},
    {"pattern": "/v1/generate", "kind": "generate"}
  ],
  "mcp": {
    "methodPrefixes": [
      "tools/",
      "resources/",
      "prompts/",
      "sampling/",
      "roots/",
      "notifications/",
      "completion/",
      "logging/",
      "elicitation/"
    ],
    "methods": ["initialize"],
    "pathPrefixes": ["/mcp", "/sse", "/messages"],
    "headerNames": ["mcp-session-id", "mcp-protocol-version"],
    "packagePrefixes": [
      "@modelcontextprotocol/",
      "@mcp/",
      "mcp-server-",
      "mcp_server_",
      "mcp-remote",
      "mcp/"
    ],
    "packageSuffixes": ["-mcp", "_mcp", "-mcp-server", "-mcp.js"],
    "packageContains": ["modelcontextprotocol", "/mcp-server-", "/mcp_server_"],
    "pythonModulePrefixes": ["mcp"],
    "launchers": [
      "npx",
      "npm",
      "pnpm",
      "pnpx",
      "yarn",
      "bun",
      "bunx",
      "uv",
      "uvx",
      "pipx",
      "python",
      "python3",
      "node",
      "deno",
      "docker",
      "podman",
      "nerdctl"
    ],
    "configFiles": [".mcp.json", "claude_desktop_config.json", "mcp_settings.json"],
    "configDirFiles": ["mcp.json", "servers.json"],
    "configDirs": [
      "/.cursor/",
      "/.config/",
      "/.vscode/",
      "/.claude/",
      "/.codeium/",
      "/.windsurf/",
      "/.continue/",
      "/.gemini/"
    ]
  },
  "a2a": {
    "pathPrefixes": ["/.well-known/agent"],
    "methodPrefixes": ["message/", "tasks/"],
    "methods": ["agent/getAuthenticatedExtendedCard"]
  }
}
